{
  "name": "ares-console",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:db": "playwright test --config playwright.persistence.config.ts",
    "test:access": "playwright test --config playwright.access.config.ts"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "monaco-editor": "0.57.0",
    "pinia": "^4.1.0",
    "three": "^0.186.1",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
