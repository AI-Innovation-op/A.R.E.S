HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://ares:ares_local@localhost:5432/ares_db
DATABASE_AUTO_MIGRATE=true
LOCAL_COMMANDER_ID=00000000-0000-4000-8000-000000000001
# Opcional: carpetas locales habilitadas, separadas por punto y coma. Por defecto: raíz de A.R.E.S.
ARES_WORKSPACE_ROOTS=
ARES_BACKUP_ENABLED=true
ARES_BACKUP_INTERVAL_HOURS=24
ARES_BACKUP_KEEP=7
# Vacío: .local-setup/backups. ARES_PG_BIN permite herramientas PostgreSQL nativas.
ARES_BACKUP_DIR=
ARES_PG_BIN=
ARES_ACCESS_MODE=local
# Docker es el modo predeterminado. Preparar una vez: npm run runner:prepare
ARES_RUNNER_MODE=docker
# Sirve frontend/dist copiado a backend/public solo en la imagen de producción.
ARES_SERVE_FRONTEND=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5175,http://127.0.0.1:5175
GEMINI_API_KEY=
# Configura un modelo disponible en tu proyecto de Google.
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_MS=60000
# Gemini 3 Flash: low favorece la latencia; medium/high dedican más tiempo al razonamiento.
GEMINI_THINKING_LEVEL=low
OPENROUTER_API_KEY=
# Modelo inicial gratuito consultado en el catálogo; se puede cambiar en la consola.
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_MAX_TOKENS=4096
