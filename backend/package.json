{
  "name": "ares-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "tsx src/config/migrate-cli.ts",
    "test:db": "node --import tsx --test --test-concurrency=1 test/postgres/*.test.ts",
    "backup:create": "tsx src/modules/maintenance/cli.ts create",
    "backup:list": "tsx src/modules/maintenance/cli.ts list",
    "backup:verify": "tsx src/modules/maintenance/cli.ts verify",
    "backup:recover": "tsx src/modules/maintenance/cli.ts recover",
    "access:recover": "tsx src/modules/access/recover-cli.ts",
    "test:isolation": "node --import tsx --test test/docker/*.test.ts"
  },
  "dependencies": {
    "@babel/parser": "8.0.8",
    "@google/genai": "^2.31.0",
    "cors": "^2.8.6",
    "diff": "^9.0.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
